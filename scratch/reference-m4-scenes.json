  "phoneInfo": {
    "sectionHtml": "<section data-pup-scene=\"true\" data-tone=\"light\" class=\"tp-scene tp-chat\" style=\"--sky-top:#f7d18d;--sky-bottom:#f0b866\" aria-labelledby=\"journey-title\" data-here=\"false\" data-visited=\"false\"><div class=\"tp-chat__grid gutter\" data-pin-range=\"true\"><div class=\"tp-chat__story\"><h2 id=\"journey-title\" class=\"font-plush text-huge\">Your puppy journey</h2><p class=\"text-lede mt-5 max-w-[42ch] text-[var(--ink-soft)]\">A premium, step-by-step concierge experience. We make adoption simple, secure, and purely joyful.</p><ol class=\"tp-chat__steps\"><li class=\"tp-chat__step\"><span class=\"tp-chat__num font-plush\" aria-hidden=\"true\">1</span><h3 class=\"font-plush tp-chat__title\">Choose your breed</h3><p class=\"tp-chat__text\">Select your preferred breed or tell us what you're looking for. We'll guide you based on availability and your lifestyle.</p></li><li class=\"tp-chat__step\"><span class=\"tp-chat__num font-plush\" aria-hidden=\"true\">2</span><h3 class=\"font-plush tp-chat__title\">Get photos &amp; details</h3><p class=\"tp-chat__text\">Our team will share real photos, health details, and all necessary information directly on WhatsApp.</p></li><li class=\"tp-chat__step\"><span class=\"tp-chat__num font-plush\" aria-hidden=\"true\">3</span><h3 class=\"font-plush tp-chat__title\">Secure &amp; safe delivery</h3><p class=\"tp-chat__text\">Once confirmed, we handle everything professionally and ensure your puppy reaches you safely and stress-free.</p></li></ol><a class=\"btn btn-ghost tp-chat__cta\" href=\"/how-it-works\">How it works</a></div><div class=\"tp-chat__side\" style=\"\"><div class=\"tp-phone\" aria-label=\"A WhatsApp conversation with TeddyPups U.A.E.\" role=\"group\"><div class=\"tp-phone__bar\"><img alt=\"\" loading=\"lazy\" width=\"40\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"tp-phone__avatar\" style=\"color:transparent\" srcset=\"/_next/image?url=%2Fbrand%2Flogo.png&amp;w=48&amp;q=75 1x, /_nex