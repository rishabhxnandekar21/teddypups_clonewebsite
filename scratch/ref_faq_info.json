  "mainHTML": "<main id=\"main\" tabindex=\"-1\" class=\"relative pt-[var(--header-h)] outline-none\"><!--&--><!--&--><div data-page=\"faq\" class=\"tp-page\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Are your puppies vaccinated and health-checked?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. All our puppies come with a verified health certificate from licensed vets. Every puppy is vaccinated, dewormed, and thoroughly checked before joining your family.\"}},{\"@type\":\"Question\",\"name\":\"Can I meet a puppy before I decide?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Come meet our locally available puppies in our Downtown Dubai showroom and spend time bonding before making your decision.\"}},{\"@type\":\"Question\",\"name\":\"Can I take my puppy home the same day?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Local puppies are available immediately, so you can take your puppy home the same day.\"}},{\"@type\":\"Question\",\"name\":\"Do you import puppies from abroad?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Through our Order Upon Request service we source rare and premium teacup breeds from the most reputable, certified breeders across Europe, Korea, and beyond — and we handle the import for you.\"}},{\"@type\":\"Question\",\"name\":\"How does an imported puppy travel to Dubai?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We manage every part of the import process, including health checks, travel arrangements, and the necessary documentation, so your puppy arrives happy, healthy, and stress-free.\"}},{\"@type\":\"Question\",\"name\":\"Will I see photos and health details first?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Photos, videos, and health certificates are shared before your puppy travels, and our team sends real photos and health details directly on WhatsApp.\"}},{\"@type\":\"Question\",\"name\":\"Do you deliver?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. We deliver within Dubai, and our trusted international cargo partners deliver puppies safely to loving homes all around the world.\"}},{\"@type\":\"Question\",\"name\":\"Which breeds do you usually have?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Breeds we regularly have include Maltipoo, Pomeranian, Poodle and Bichon, plus rare teacup lines such as Korean teacup poodles, Maltese, Pom and Yorkie.\"}},{\"@type\":\"Question\",\"name\":\"Is there help after my puppy comes home?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Our team is available 24/7 and offers advice on training, nutrition, and general care to ensure a smooth transition for you and your new furry friend.\"}}]}</script><section data-pup-scene=\"true\" data-tone=\"dark\" class=\"tp-scene tp-faqroom overflow-hidden\" style=\"--sky-top:#a95e32;--sky-bottom:#331c11\" aria-labelledby=\"faq-title\"><div class=\"gutter relative mx-auto max-w-[110rem] pb-24 pt-10 md:pt-16\"><header class=\"max-w-4xl\"><h1 id=\"faq-title\" class=\"font-plush text-giant\">Questions &amp; answers</h1><p class=\"text-lede mt-6 max-w-[52ch] text-[var(--ink-soft)]\">Can't find what you're looking for? Message us on WhatsApp — our team is available 24/7.</p></header><div class=\"mt-12 md:mt-16\"><div class=\"tp-notes\"><aside class=\"tp-notes__side\" aria-label=\"Find a question\"><label for=\"_R_4pbsnkivb_\" class=\"font-scrawl tp-notes__label\">sniff out a question</label><div class=\"tp-notes__search\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" class=\"tp-notes__lens\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"m15.5 15.5 5 5\"></path></svg><input id=\"_R_4pbsnkivb_\" type=\"search\" placeholder=\"delivery, Korea, vaccinated…\" autocomplete=\"off\" value=\"\"></div><p class=\"tp-notes__count\" aria-live=\"polite\">9 notes on the board</p><div class=\"tp-notes__teddy\"><span aria-hidden=\